MODE=local
OPENAI_API_KEY=sk-xxxxxxx
OPENAI_API_BASE=https://openrouter.ai/api/v1
VOICE_CLONE_AUDIO=audio/Nafay_Org.mp3
WHISPER_MODEL=base

# TTS Model Configuration
# Options: chatterbox, voxcpm, rvc, fast, xtts
# xtts = Coqui XTTS (10-30 sec, voice cloning, reliable) - RECOMMENDED!
# fast = edge-tts only (2-3 seconds, no voice cloning)
# rvc = edge-tts + voice conversion (has dependency issues)
TTS_MODEL=xtts

# Coqui XTTS specific settings (only used if TTS_MODEL=xtts)
XTTS_LANGUAGE=en

# RVC specific settings (only used if TTS_MODEL=rvc)
RVC_BASE_TTS=piper
RVC_PITCH_SHIFT=0
RVC_INDEX_RATE=0.5
RVC_FILTER_RADIUS=3
RVC_RMS_MIX_RATE=0.25
RVC_PROTECT_RATE=0.33

# VoxCPM specific settings (only used if TTS_MODEL=voxcpm)
VOXCPM_MODEL_PATH=VoxCPM-0.5B
VOXCPM_CFG_VALUE=2.0
VOXCPM_INFERENCE_TIMESTEPS=10
VOXCPM_NORMALIZE=true
VOXCPM_DENOISE=true
VOXCPM_RETRY_BADCASE=true


