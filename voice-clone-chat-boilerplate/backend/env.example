MODE=local
VOICE_CLONE_AUDIO=audio/Nafay_Org.mp3
WHISPER_MODEL=base


# # Option 1: Fast (Parallel)
TRANSCRIPTION_MODE=parallel
WHISPER_WORKERS=3


# Option 2: Low Memory (Sequential)
# TRANSCRIPTION_MODE=sequential

# Qlu AI Configuration (replaces OpenRouter)
LLM_ENVIRONMENT=local
QLU_API_KEY=
LLM_PROXY_GATEWAY_URL=
# LLM Model Configuration
LLM_MODEL=openai/gpt-4.1-mini-2025-04-14
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# TTS Model Configuration
TTS_MODEL=chatterbox

# Coqui XTTS specific settings (only used if TTS_MODEL=xtts)
XTTS_LANGUAGE=en

# RVC specific settings (only used if TTS_MODEL=rvc)
RVC_BASE_TTS=piper
RVC_PITCH_SHIFT=0
RVC_INDEX_RATE=0.5
RVC_FILTER_RADIUS=3
RVC_RMS_MIX_RATE=0.25
RVC_PROTECT_RATE=0.33

# VoxCPM specific settings (only used if TTS_MODEL=voxcpm)
VOXCPM_MODEL_PATH=VoxCPM-0.5B
VOXCPM_CFG_VALUE=2.0
VOXCPM_INFERENCE_TIMESTEPS=10
VOXCPM_NORMALIZE=true
VOXCPM_DENOISE=true
VOXCPM_RETRY_BADCASE=true

# ==============================================
# GPU DEVICE CONFIGURATION - ALL MODELS
# ==============================================
# Set which GPU to use for each model type
# Options: cuda:0 (GPU 0), cuda:1 (GPU 1), cpu

# Speech-to-Text (Whisper) GPU
STT_DEVICE=cuda:1

# Text-to-Speech (Voice Cloning) GPU  
TTS_DEVICE=cuda:1

# Avatar Generation GPU
AVATAR_DEVICE=cuda:1

# ==============================================
# AVATAR GENERATION SETTINGS
# ==============================================
AVATAR_ENABLED=true

# Avatar Model Selection
# Options: "sadtalker" or "ditto"
# - sadtalker: Stable, GFPGAN enhancement, lower memory (4-6GB)
# - ditto: 50% faster, higher quality, real-time capable, higher memory (6-8GB)
AVATAR_MODEL=sadtalker

# Output video size (256 or 512)
# 256 = Faster processing, lower quality
# 512 = Slower processing, higher quality
AVATAR_SIZE=256

# Face enhancement (gfpgan or None)
# Only used by SadTalker. Ditto has built-in quality.
AVATAR_ENHANCER=None

# Processing mode (fast or quality)
# fast = Real-time optimized
# quality = Best quality output
AVATAR_MODE=fast

# ==============================================
# DITTO STREAMING SETTINGS (Only for AVATAR_MODEL=ditto)
# ==============================================

# Streaming mode for Ditto
# Options: "offline" or "online"
# - offline: Full audio processed upfront (2x realtime, highest quality)
# - online: Chunked processing (1.5-2x realtime, real-time streaming)
DITTO_STREAMING_MODE=offline

# Chunk duration for streaming (seconds)
# Smaller = lower latency, more chunks
# Larger = fewer chunks, smoother
# Recommended: 3.0-5.0 seconds
DITTO_CHUNK_DURATION=3.0

# Overlap between chunks for smooth transitions (seconds)
# Recommended: 0.3-0.5 seconds
DITTO_CHUNK_OVERLAP=0.5

# Maximum parallel chunks to generate
# Higher = faster but more memory
# Recommended: 2-4 for RTX 3090
DITTO_MAX_PARALLEL_CHUNKS=3

# Enable chunk pre-buffering
# true = Start generating next chunk before current finishes
# false = Wait for current chunk to finish
DITTO_ENABLE_PREBUFFER=true