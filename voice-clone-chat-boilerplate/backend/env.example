# =============================================================================
# VOICE CLONE CHAT BACKEND - ENVIRONMENT CONFIGURATION
# =============================================================================

# LLM Configuration
LLM_MODEL=qlu

# TTS Model Selection
# Options: chatterbox, piper, voxcpm
TTS_MODEL=chatterbox

# Voice Clone Reference Audio
VOICE_CLONE_AUDIO=audio/Nafay_Org.mp3

# Avatar Configuration
AVATAR_ENABLED=True

# =============================================================================
# GPU DEVICE CONFIGURATION
# =============================================================================
# Configure which GPU device to use for each model
# Supports: cuda:0, cuda:1, cuda:2, cpu, etc.
#
# Examples:
#   STT_DEVICE=cuda:0      # Use first GPU for Speech-to-Text
#   TTS_DEVICE=cuda:1      # Use second GPU for Text-to-Speech
#   AVATAR_DEVICE=cuda:1   # Use second GPU for Avatar Generation
#   STT_DEVICE=cpu         # Use CPU only for STT
#
# Benefits:
#   - Load balance across multiple GPUs
#   - Separate models to avoid VRAM conflicts
#   - Mix GPU and CPU processing as needed
# =============================================================================

# Speech-to-Text (Whisper) Device
# Default: cuda if available, else cpu
STT_DEVICE=cuda:1

# Text-to-Speech (ChatterBox/Piper/VoxCPM) Device
# Default: cuda if available, else cpu
TTS_DEVICE=cuda:1

# Avatar Generation (SadTalker) Device
# Default: cuda:0
AVATAR_DEVICE=cuda:1

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# Configuration 1: All models on GPU 1 (recommended for single powerful GPU)
# STT_DEVICE=cuda:1
# TTS_DEVICE=cuda:1
# AVATAR_DEVICE=cuda:1

# Configuration 2: Distribute across 2 GPUs (recommended for dual GPU setup)
# STT_DEVICE=cuda:0
# TTS_DEVICE=cuda:0
# AVATAR_DEVICE=cuda:1

# Configuration 3: CPU for STT, GPU for TTS and Avatar (if GPU VRAM limited)
# STT_DEVICE=cpu
# TTS_DEVICE=cuda:0
# AVATAR_DEVICE=cuda:0


